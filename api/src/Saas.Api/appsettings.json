{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "App": {
    "WebBaseUrl": "http://localhost:3700",
    "ApiBaseUrl": "http://localhost:5080",
    "ProductWebUrls": {
      "invoices": "http://localhost:3800",
      "bookings": "http://localhost:3900",
      "courses": "http://localhost:4000",
      "property": "http://localhost:4100",
      "school": "http://localhost:4200",
      "admin": "http://localhost:4300",
      "care": "http://localhost:4400"
    }
  },
  "Cors": {
    "Origins": [
      "http://localhost:3700",
      "http://localhost:3800",
      "http://localhost:3900",
      "http://localhost:4000",
      "http://localhost:4100",
      "http://localhost:4200",
      "http://localhost:4300",
      "http://localhost:4400"
    ]
  },
  "Jwt": {
    "Issuer": "saas-api",
    "Audience": "saas-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Email": {
    "FromEmail": "no-reply@example.com",
    "FromName": "OrderLink",
    "BrevoApiKey": ""
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": "uploads",
    "R2AccountId": "",
    "R2AccessKeyId": "",
    "R2SecretAccessKey": "",
    "R2Bucket": "",
    "R2PublicBaseUrl": ""
  },
  "Paystack": {
    "SecretKey": ""
  },
  "Notifications": {
    "DispatcherEnabled": true
  },
  "Jobs": {
    "InvoicesEnabled": true,
    "BookingsEnabled": true
  },
  "Platform": {
    "AdminEmails": ["guysky19@gmail.com"]
  },
  "Media": {
    "SigningKey": "",
    "LinkLifetimeMinutes": 120
  },
  "Video": {
    "FfmpegPath": "ffmpeg",
    "ProcessorEnabled": true
  }
