{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "api/src/Saas.Api",
        "--launch-profile",
        "http"
      ],
      "port": 5080
    },
    {
      "name": "api-local-db",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "api/src/Saas.Api",
        "--launch-profile",
        "http"
      ],
      "env": {
        "ConnectionStrings__Default": "Host=localhost;Port=55480;Database=saas;Username=postgres;Password=postgres"
      },
      "port": 5080
    },
    {
      "name": "hub-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "hub-web",
        "run",
        "dev"
      ],
      "port": 3600
    },
    {
      "name": "web",
