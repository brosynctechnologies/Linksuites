# Copy to /opt/linksuite/.env (chmod 600). Never commit the real file.

# Public addresses. NEXT_PUBLIC_* are baked into the web builds: rebuild the web apps after changing these.
HUB_URL=https://linksuite.brosync.ng
API_URL=https://api.linksuite.brosync.ng
ORDERS_URL=https://orders.linksuite.brosync.ng
INVOICES_URL=https://invoices.linksuite.brosync.ng
BOOK_URL=https://book.linksuite.brosync.ng
LEARN_URL=https://learn.linksuite.brosync.ng
PROPERTY_URL=https://property.linksuite.brosync.ng
SCHOOL_URL=https://school.linksuite.brosync.ng
CARE_URL=https://care.linksuite.brosync.ng
# Optional: the contact address shown on the LinkSuite hub. Leave empty to hide it.
CONTACT_EMAIL=
ADMIN_URL=https://admin.linksuite.brosync.ng

# Required secrets (generate with: openssl rand -base64 48 | tr -d '\n/+=')
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=

# Platform super-admin (signs in at ADMIN_URL)
PLATFORM_ADMIN_EMAIL=

# Email. Sender order: SMTP_HOST set -> SMTP; else BREVO_API_KEY set -> Brevo; else emails are only logged.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=<gmail address>, SMTP_PASSWORD=<Google app password>,
# and EMAIL_FROM must be that same Gmail address (Gmail rewrites any other From). Limit ~500 emails/day.
EMAIL_FROM=no-reply@brosync.ng
EMAIL_FROM_NAME=LinkSuite
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
# Set with: ssh -t healthtutor-vps bash /opt/linksuite/deploy/set-secret.sh SMTP_PASSWORD
SMTP_PASSWORD=

# Payments (platform plan upgrades, course sales, short-lets)
PAYSTACK_SECRET_KEY=

# Online payment on/off, the plan provider and the company bank account for plan transfers are set in the admin console
# (Money > Payment settings); they start with online payment off. BILLING_PROVIDER is only the default provider until an admin
# picks one there. Keys stay here: a provider whose keys are missing can't be switched on in the console.
# Plan billing provider default: paystack or opay. Course sales, short-lets and boosts always use Paystack.
# Payments already taken keep being verified with the provider that took them.
BILLING_PROVIDER=paystack
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
# Set with: ssh -t healthtutor-vps bash /opt/linksuite/deploy/set-secret.sh OPAY_SECRET_KEY
OPAY_SECRET_KEY=
# Required in production: live is https://api.opaycheckout.com. Left empty (or the sandbox host), OPay counts as not configured in
# production and plan checkouts with OPay answer 503, so test cards can't buy real plans.
OPAY_BASE_URL=https://api.opaycheckout.com
# Only to test with the sandbox on the live server on purpose (test payments would activate real plans). Leave false.
OPAY_ALLOW_SANDBOX_IN_PRODUCTION=false

# Media storage: Local (Docker volume) or R2
STORAGE_PROVIDER=Local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
